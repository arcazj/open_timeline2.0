{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbexi.local/schemas/configuration-definition.schema.json",
  "$defs": {
    "id": {"type":"string","minLength":1,"maxLength":128},
    "pin": {"type":"object","additionalProperties":false,"required":["id","version"],"properties":{"id":{"$ref":"#/$defs/id"},"version":{"type":"integer","minimum":1,"maximum":32}}},
    "nullablePin": {"oneOf":[{"type":"null"},{"$ref":"#/$defs/pin"}]},
    "search": {"type":"object","additionalProperties":false,"required":["text","mode","caseSensitive","fields"],"properties":{"text":{"type":"string","maxLength":512},"mode":{"enum":["any","all","phrase"]},"caseSensitive":{"type":"boolean"},"fields":{"type":"array","minItems":1,"maxItems":16,"uniqueItems":true,"items":{"type":"string","maxLength":256}}}},
    "partialSearch": {"type":"object","additionalProperties":false,"properties":{"text":{"type":"string","maxLength":512},"mode":{"enum":["any","all","phrase"]},"caseSensitive":{"type":"boolean"},"fields":{"type":"array","minItems":1,"maxItems":16,"uniqueItems":true,"items":{"type":"string","maxLength":256}}}},
    "range": {"type":"object","additionalProperties":false,"properties":{"from":{"type":"string","format":"timeline-instant"},"to":{"type":"string","format":"timeline-instant"}}},
    "settings": {
      "type":"object","additionalProperties":false,
      "properties": {
        "theme":{"enum":["light","classic","dark"]},"rowHeight":{"type":"integer","minimum":32,"maximum":128},"fontSize":{"type":"integer","minimum":11,"maximum":24},"groupBy":{"enum":["none","sourceId","kind"]},
        "displayUnit":{"enum":["MILLISECOND","SECOND","MINUTE","HOUR","DAY","WEEK","MONTH","YEAR","DECADE","CENTURY","MILLENNIUM"]},"timeZone":{"type":"string","minLength":1,"maxLength":100},"scaleMode":{"enum":["uniform","adaptive"]},"ratio":{"type":"number","minimum":1,"maximum":32},"bins":{"type":"integer","minimum":16,"maximum":256},"presentation":{"type":"object"},
        "mode":{"enum":["timeline","table","split"]},"range":{"$ref":"#/$defs/range"},"overview":{"$ref":"#/$defs/range"},"referenceTime":{"type":"string","format":"timeline-instant"},
        "collapsedGroups":{"type":"array","maxItems":100,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
        "columns":{"type":"array","minItems":1,"maxItems":32,"items":{"type":"object","additionalProperties":false,"required":["field","visible","width"],"properties":{"field":{"type":"string","maxLength":256},"visible":{"type":"boolean"},"width":{"type":"integer","minimum":44,"maximum":2000}}}},
        "sort":{"type":"array","minItems":1,"maxItems":3,"items":{"type":"object","additionalProperties":false,"required":["field","direction"],"properties":{"field":{"type":"string","maxLength":256},"direction":{"enum":["asc","desc"]}}}},
        "search":{"$ref":"#/$defs/partialSearch"},
        "modelId":{"type":"string","minLength":1,"maxLength":128},"modelVersion":{"type":"integer","minimum":1,"maximum":32},
        "filterId":{"type":["string","null"],"minLength":1,"maxLength":128},"filterVersion":{"type":["integer","null"],"minimum":1,"maximum":32},
        "viewId":{"type":["string","null"],"minLength":1,"maxLength":128},"viewVersion":{"type":["integer","null"],"minimum":1,"maximum":32}
      }
    },
    "sources": {"type":"object","additionalProperties":false,"required":["storage","enabled","writable","defaultSchema"],"properties":{"storage":{"const":"json"},"enabled":{"type":"boolean"},"writable":{"type":"boolean"},"defaultSchema":{"$ref":"#/$defs/nullablePin"}}},
    "groups": {"type":"object","additionalProperties":false,"required":["order","color","collapsed"],"properties":{"order":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},"color":{"type":["string","null"],"minLength":7,"maxLength":7,"pattern":"^#[0-9a-fA-F]{6}$"},"collapsed":{"type":"boolean"}}},
    "schemas": {"type":"object","additionalProperties":false,"required":["schema"],"properties":{"schema":{"type":"object"}}},
    "filters": {"type":"object","additionalProperties":false,"required":["sourceIds","kinds","schemaRefs","expression","search"],"properties":{"sourceIds":{"type":["array","null"],"maxItems":100,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"kinds":{"type":"array","maxItems":2,"uniqueItems":true,"items":{"enum":["event","session"]}},"schemaRefs":{"type":"array","maxItems":100,"uniqueItems":true,"items":{"$ref":"#/$defs/pin"}},"expression":{"type":["object","null"]},"search":{"$ref":"#/$defs/search"}}},
    "views": {"type":"object","additionalProperties":false,"required":["model","filter","settings"],"properties":{"model":{"$ref":"#/$defs/pin"},"filter":{"$ref":"#/$defs/nullablePin"},"settings":{"$ref":"#/$defs/settings"}}}
  }
}
