{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbexi.local/schemas/record.schema.json",
  "title": "Canonical timeline record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "workspaceId", "kind", "title", "start", "end", "parentSessionId", "order", "sourceId", "groupIds", "tags", "data", "render", "extensions", "schemaId", "schemaVersion", "originalStart", "originalEnd", "version", "createdAt", "updatedAt", "createdBy", "updatedBy", "deletedAt"],
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "workspaceId": {"type": "string", "minLength": 1, "maxLength": 100},
    "kind": {"enum": ["event", "session"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 500},
    "start": {"type": "string", "format": "timeline-instant"},
    "end": {"type": ["string", "null"], "format": "timeline-instant"},
    "parentSessionId": {"type": ["string", "null"], "format": "uuid"},
    "order": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
    "sourceId": {"type": "string", "minLength": 1, "maxLength": 128},
    "groupIds": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "tags": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "maxLength": 100}},
    "data": {"type": "object"},
    "render": {"$ref": "record-render.schema.json"},
    "extensions": {"type": "object"},
    "schemaId": {"type": ["string", "null"]},
    "schemaVersion": {"type": ["integer", "null"], "minimum": 1},
    "originalStart": {"type": ["string", "null"], "format": "timeline-instant"},
    "originalEnd": {"type": ["string", "null"], "format": "timeline-instant"},
    "version": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "createdBy": {"type": "string"},
    "updatedBy": {"type": "string"},
    "deletedAt": {"type": ["string", "null"], "format": "date-time"}
  }
}
