{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbexi.local/schemas/snapshot.schema.json",
  "title": "Complete portable timeline snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "manifest", "records", "zones", "models", "filters", "settings"],
  "properties": {
    "format": {"const": "timeline-snapshot"},
    "formatVersion": {"const": 1},
    "manifest": {
      "type": "object",
      "required": ["bundleId", "workspaceId", "generation", "revision", "snapshotAt", "sourceName", "sourceKind", "completeness", "recordCount", "scope"],
      "properties": {
        "bundleId": {"type": "string", "format": "uuid"},
        "workspaceId": {"type": "string", "minLength": 1},
        "generation": {"type": "string", "format": "uuid"},
        "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "snapshotAt": {"type": "string", "format": "date-time"},
        "sourceName": {"type": "string", "minLength": 1, "maxLength": 200},
        "sourceKind": {"enum": ["sample", "server", "imported", "local"]},
        "completeness": {"const": "complete-for-declared-universe"},
        "recordCount": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "scope": {"type": "object", "required": ["workspaceId", "sourceIds"], "properties": {"workspaceId": {"type": "string"}, "sourceIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}}
      }
    },
    "records": {"type": "array", "maxItems": 1000000, "items": {"$ref": "record.schema.json"}},
    "zones": {"type": "array", "maxItems": 512, "items": {"type": "object", "required": ["id", "title", "start", "end", "color", "opacity"], "properties": {"id": {"type": "string"}, "title": {"type": "string", "maxLength": 200}, "start": {"type": "string", "format": "timeline-instant"}, "end": {"type": "string", "format": "timeline-instant"}, "color": {"type": "string", "minLength": 7, "maxLength": 7, "pattern": "^#[0-9a-fA-F]{6}$"}, "opacity": {"type": "number", "minimum": 0, "maximum": 1}}}},
    "models": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"oneOf": [{"$ref": "visual-model.schema.json"}, {"$ref": "#/definitions/legacyPreset"}]}},
    "filters": {"type": "array", "maxItems": 100},
    "sources": {"$ref": "configuration-state.schema.json#/properties/sources"},
    "groups": {"$ref": "configuration-state.schema.json#/properties/groups"},
    "schemas": {"$ref": "configuration-state.schema.json#/properties/schemas"},
    "views": {"$ref": "configuration-state.schema.json#/properties/views"},
    "preferences": {"$ref": "configuration-state.schema.json#/properties/preferences"},
    "defaults": {"$ref": "configuration-state.schema.json#/properties/defaults"},
    "settings": {"type": "object", "required": ["range", "overview", "referenceTime", "modelId", "scaleMode", "ratio", "bins"], "properties": {"range": {"$ref": "#/definitions/range"}, "overview": {"$ref": "#/definitions/range"}, "referenceTime": {"type": "string", "format": "timeline-instant"}, "modelId": {"type": "string"}, "scaleMode": {"enum": ["uniform", "adaptive"]}, "ratio": {"type": "number", "minimum": 1, "maximum": 32}, "bins": {"type": "integer", "minimum": 16, "maximum": 256}}}
  },
  "definitions": {
    "range": {"type": "object", "required": ["from", "to"], "properties": {"from": {"type": "string", "format": "timeline-instant"}, "to": {"type": "string", "format": "timeline-instant"}}},
    "legacyPreset": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "theme", "rowHeight", "fontSize", "groupBy"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 100},
        "theme": {"enum": ["light", "classic", "dark"]},
        "version": {"type": "integer", "minimum": 1, "maximum": 1},
        "rowHeight": {"type": "integer", "minimum": 32, "maximum": 128},
        "fontSize": {"type": "integer", "minimum": 11, "maximum": 24},
        "groupBy": {"enum": ["none", "sourceId", "kind"]}
      }
    }
  }
}
